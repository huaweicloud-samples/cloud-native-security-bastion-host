# ============================================================================
# Terraform 变量示例文件（模板）
# 用法：复制本文件为 terraform.tfvars（或 dev.tfvars），再填入你自己的值。
#       本文件不含任何真实 AK/SK 或密钥，可直接提交到仓库。
# ============================================================================

# ------------------------------------------------------------------------------
# VPC 配置
# ------------------------------------------------------------------------------
vpc_cidr            = "10.10.0.240/28"
vpc_private_subnets = ["10.10.0.240/28"]

# ------------------------------------------------------------------------------
# 跳板机配置
# ------------------------------------------------------------------------------
instance_type      = "s6.small.1"
target_environment = "dev"
tag_application    = "sandbox"

# 运维者 SSH 入口限制：生产务必改为你的公网 IP，如 "203.0.113.10/32"
admin_access_cidr = "0.0.0.0/0"

# 替换为你的真实 SSH 公钥（ssh-ed25519 AAAA... 或 ssh-rsa AAAA...）
# 生成方式：ssh-keygen -t ed25519 -f ~/.ssh/sandbox-dev-bastion-key
ssh_public_key = "<your-ssh-public-key>"

# 系统盘加密（KMS）
encrypt_system_disk = true

# 公共镜像（Ubuntu 22.04，区域可用时自动选取最新版本）
image_os         = "Ubuntu"
image_os_version = "22.04"
